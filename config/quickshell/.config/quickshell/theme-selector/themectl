#!/bin/bash
set -euo pipefail

QUICKSHELL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ -f "$HOME/.config/prometheus/environment.sh" ]]; then
  source "$HOME/.config/prometheus/environment.sh"
fi
PROMETHEUS_ROOT="${PROMETHEUS_PATH:-$HOME/.local/share/prometheus}"

export PROMETHEUS_PATH="$PROMETHEUS_ROOT"
export PATH="$PROMETHEUS_ROOT/bin:$PATH"

case "${1:-}" in
  current)
    exec prometheus-theme-current
    ;;
  list)
    exec prometheus-theme-list-colors
    ;;
  set)
    shift
    exec prometheus-theme-set "$@"
    ;;
  *)
    echo "Usage: themectl {current|list|set <theme-name>}" >&2
    exit 2
    ;;
esac
