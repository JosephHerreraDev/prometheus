#!/bin/bash

# Launch the TUI command passed in as an argument in the default terminal with an org.prometheus.COMMAND app id for styling.

TUI_NAME="${PROMETHEUS_TUI_NAME:-$(basename "$1")}"
APP_ID="org.prometheus.$TUI_NAME"

if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec setsid uwsm-app -- xdg-terminal-exec --app-id="$APP_ID" -e "$@"
elif command -v kitty >/dev/null 2>&1; then
  exec setsid uwsm-app -- kitty --app-id="$APP_ID" -e "$@"
else
  echo "Error: No supported terminal found. Install xdg-terminal-exec or kitty."
  exit 1
fi
