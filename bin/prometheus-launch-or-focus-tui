#!/bin/bash

# Launch or focus on a given TUI identified by the passed in as the command.
# Use by commands like prometheus-launch-wifi to ensure there is only one wifi configuration screen open.

TUI_NAME="${PROMETHEUS_TUI_NAME:-$(basename "$1")}"
APP_ID="org.prometheus.$TUI_NAME"
LAUNCH_COMMAND=$(printf "%q " env "PROMETHEUS_TUI_NAME=$TUI_NAME" prometheus-launch-tui "$@")

exec prometheus-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
