#!/usr/bin/env bash

# Display a completion message and keep the presentation terminal open.

set -euo pipefail

message="${1:-Done!}"
prompt="${PROMETHEUS_DONE_PROMPT:-Press any key to close...}"

printf '\n\033[32m%s\033[0m\n' "$message"

if [[ -t 0 ]]; then
  printf '\n%s' "$prompt"
  IFS= read -r -n 1 -s
fi
